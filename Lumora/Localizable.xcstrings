    "Auto-renews for %@ per month until canceled. Cancel anytime in Settings.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتجدد تلقائيًا مقابل %@ شهريًا حتى الإلغاء. يمكنك الإلغاء في أي وقت من الإعدادات."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Es renova automàticament per %@ al mes fins que es cancel·li. Cancel·la quan vulguis a Configuració."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Automaticky se obnovuje za %@ měsíčně, dokud ho nezrušíte. Zrušit můžete kdykoli v Nastavení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fornyes automatisk for %@ om måneden, indtil det opsiges. Opsig når som helst i Indstillinger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verlängert sich automatisch für %@ pro Monat bis zur Kündigung. Jederzeit in den Einstellungen kündbar."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ανανεώνεται αυτόματα για %@ τον μήνα μέχρι να ακυρωθεί. Ακύρωση οποτεδήποτε από τις Ρυθμίσεις."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se renueva automáticamente por %@ al mes hasta que se cancele. Cancela cuando quieras en Ajustes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Uusiutuu automaattisesti hintaan %@ kuukaudessa, kunnes se perutaan. Peru milloin tahansa Asetuksissa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Renouvellement automatique à %@ par mois jusqu’à résiliation. Annulez à tout moment dans Réglages."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מתחדש אוטומטית ב-%@ לחודש עד לביטול. ניתן לבטל בכל עת בהגדרות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रद्द किए जाने तक %@ प्रति माह पर स्वतः नवीनीकृत होता है। सेटिंग्स में कभी भी रद्द करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatski se obnavlja za %@ mjesečno dok se ne otkaže. Otkaži bilo kada u Postavkama."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Lemondásig automatikusan megújul havi %@ áron. Bármikor lemondható a Beállításokban."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Diperpanjang otomatis seharga %@ per bulan hingga dibatalkan. Batalkan kapan saja di Pengaturan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si rinnova automaticamente a %@ al mese fino all’annullamento. Annulla quando vuoi in Impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャンセルするまで毎月%@で自動更新されます。「設定」からいつでもキャンセルできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "취소할 때까지 매월 %@에 자동 갱신됩니다. 설정에서 언제든지 취소할 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Diperbaharui secara automatik pada %@ sebulan sehingga dibatalkan. Batal bila-bila masa dalam Tetapan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fornyes automatisk for %@ per måned til det sies opp. Avslutt når som helst i Innstillinger."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wordt automatisch verlengd voor %@ per maand tot je opzegt. Altijd opzegbaar in Instellingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odnawia się automatycznie za %@ miesięcznie do czasu anulowania. Anuluj w dowolnej chwili w Ustawieniach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Renova automaticamente por %@ por mês até ser cancelada. Cancele quando quiser em Ajustes."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Renova automaticamente por %@ por mês até ser cancelada. Cancele quando quiser em Definições."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Se reînnoiește automat la %@ pe lună până la anulare. Anulezi oricând din Configurări."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Автоматически продлевается за %@ в месяц до отмены. Отменить можно в любое время в Настройках."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Automaticky sa obnovuje za %@ mesačne, kým ho nezrušíte. Zrušiť môžete kedykoľvek v Nastaveniach."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Förnyas automatiskt för %@ per månad tills det avslutas. Avsluta när som helst i Inställningar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ต่ออายุอัตโนมัติในราคา %@ ต่อเดือนจนกว่าจะยกเลิก ยกเลิกได้ทุกเมื่อในการตั้งค่า"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İptal edilene kadar aylık %@ karşılığında otomatik yenilenir. Ayarlar'dan istediğin zaman iptal edebilirsin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Автоматично поновлюється за %@ на місяць до скасування. Скасувати можна будь-коли в Параметрах."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tự động gia hạn với giá %@ mỗi tháng cho đến khi bị hủy. Hủy bất cứ lúc nào trong Cài đặt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
